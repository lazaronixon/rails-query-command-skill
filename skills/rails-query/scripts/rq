#!/usr/bin/env bash
# rq — run `rails query` locally or through the command template in $RAILS_QUERY_REMOTE.
#
# Usage: rq [--sql] [--db NAME] [--page N] [--per N] [-e ENV] (EXPRESSION | - | schema [TABLE] | models | explain EXPRESSION)
#
# Environment:
#   RAILS_QUERY_REMOTE  Command template that runs `rails query`. `{args}` is replaced with the query
#                       arguments; without `{args}` they are appended. Unset = run `bin/rails query` locally.
#                       e.g. heroku run --no-tty --exit-code --app my-app "cd apps/api && bin/rails query {args}"
#                       `$1` is still accepted in place of `{args}` for older templates.
#   RQ_DEBUG=1          Print the expression and final command to stderr.
#
# Quoting follows where `{args}` sits in the template:
#   inside "…" or '…'  the string is handed to a remote shell (heroku run, ssh, sh -c), so the
#                      expression is quoted for that shell and then for the local one;
#   unquoted           only the local shell parses it, so it is quoted once.
# Either way, write the expression with normal single quotes.

set -euo pipefail

die() { echo "rq: $*" >&2; exit 2; }

if [[ -z "${RAILS_QUERY_REMOTE:-}" ]]; then
  exec bin/rails query "$@"
fi

safe() {
  [[ "$1" =~ ^[A-Za-z0-9_.-]+$ ]] || die "invalid value '$1' (allowed: letters, digits, _ . -)"
  printf '%s' "$1"
}

flags=()
positional=()

while (($#)); do
  case "$1" in
    --sql)
      flags+=(--sql); shift ;;
    --db|--database|--page|--per|-e|--environment)
      (($# >= 2)) || die "$1 needs a value"
      flags+=("$1" "$(safe "$2")"); shift 2 ;;
    --db=*|--database=*|--page=*|--per=*|--environment=*)
      flags+=("${1%%=*}" "$(safe "${1#*=}")"); shift ;;
    --)
      shift; positional+=("$@"); break ;;
    -)
      positional+=("-"); shift ;;
    -*)
      die "unknown option $1" ;;
    *)
      positional+=("$1"); shift ;;
  esac
done

read_expression() {
  if [[ -z "${1:-}" || "$1" == "-" ]]; then
    [[ -t 0 ]] && die "no expression given"
    cat
  else
    printf '%s' "$1"
  fi
}

template="$RAILS_QUERY_REMOTE"
placeholder='{args}'
if [[ "$template" != *"$placeholder"* ]]; then
  # Older templates used `$1`.
  if [[ "$template" == *'$1'* ]]; then
    placeholder='$1'
  else
    template="$template $placeholder"
  fi
fi

# Quote state (none/single/double) of the shell at the first placeholder in the template.
prefix="${template%%"$placeholder"*}"
context=none
for ((i = 0; i < ${#prefix}; i++)); do
  c="${prefix:i:1}"
  case "$context" in
    none)
      case "$c" in
        \\) ((i += 1)) ;;
        \') context=single ;;
        \") context=double ;;
      esac ;;
    single)
      [[ "$c" == \' ]] && context=none ;;
    double)
      case "$c" in
        \\) ((i += 1)) ;;
        \") context=none ;;
      esac ;;
  esac
done

quote() {
  local remote
  case "$context" in
    none)
      printf '%q' "$1" ;;
    single)
      remote="'${1//\'/\'\\\'\'}'"
      printf '%s' "${remote//\'/\'\\\'\'}" ;;
    double)
      remote="'${1//\'/\'\\\'\'}'"
      remote="${remote//\\/\\\\}"
      remote="${remote//\$/\\\$}"
      remote="${remote//\`/\\\`}"
      printf '%s' "${remote//\"/\\\"}" ;;
  esac
}

expression=""
case "${positional[0]:-}" in
  schema)
    ((${#positional[@]} <= 2)) || die "schema takes at most one table name"
    args=(schema)
    [[ -n "${positional[1]:-}" ]] && args+=("$(safe "${positional[1]}")")
    ;;
  models)
    ((${#positional[@]} == 1)) || die "models takes no arguments"
    args=(models) ;;
  explain)
    ((${#positional[@]} <= 2)) || die "quote the expression as a single argument"
    expression="$(read_expression "${positional[1]:-}")"
    args=(explain "$(quote "$expression")") ;;
  *)
    ((${#positional[@]} <= 1)) || die "quote the expression as a single argument"
    expression="$(read_expression "${positional[0]:-}")"
    args=("$(quote "$expression")") ;;
esac
args+=("${flags[@]}")

# Splice rather than ${template//"$placeholder"/…}: bash 5.2 treats `\` and `&` in the replacement specially.
command="${prefix}${args[*]}${template#*"$placeholder"}"

if [[ -n "${RQ_DEBUG:-}" ]]; then
  [[ -n "$expression" ]] && echo "rq: expression: $expression" >&2
  echo "rq: command: $command" >&2
fi

# Remote runners (heroku run, ssh, …) mix banners and boot logs into stdout. Keep the last JSON
# line as the result and send everything else to stderr.
output="$(mktemp)"
trap 'rm -f "$output"' EXIT

status=0
bash -c "$command" </dev/null >"$output" || status=$?

tr -d '\r' <"$output" >"$output.clean" && mv "$output.clean" "$output"
json="$(grep -E '^[[:space:]]*[[{]' "$output" | tail -n 1 || true)"

if [[ -z "$json" ]]; then
  cat "$output" >&2
  # A failing `rails query` already wrote its JSON error to stderr.
  ((status != 0)) && exit "$status"
  echo "rq: no JSON in output" >&2
  exit 1
fi

grep -vxF -- "$json" "$output" >&2 || true

if ((status == 0)) && [[ "$json" != '{"error":'* ]]; then
  printf '%s\n' "$json"
else
  printf '%s\n' "$json" >&2
  exit $((status == 0 ? 1 : status))
fi
