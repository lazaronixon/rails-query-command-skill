#!/usr/bin/env bash
# rq — run `rails query` locally or on a remote defined in .rails_query_remote.
#
# Usage: rq [--remote NAME] [--sql] [--db NAME] [--page N] [--per N] [-e ENV] (EXPRESSION | - | schema [TABLE] | models | explain EXPRESSION)
#        rq --remotes    List the configured remotes.
#
# Without --remote, runs `bin/rails query` locally.
#
# Remotes come from .rails_query_remote in the current directory,
# one `name: command` per line (blank lines and lines starting with # are ignored):
#
#   beta: heroku run --no-tty --exit-code --app platform-api-beta "cd apps/api && bin/rails query {args}"
#
# The command is taken literally and must contain `{args}`, which is replaced with the query arguments.
#
# Quoting follows where `{args}` sits in the command:
#   inside "…" or '…'  the string is handed to a remote shell (heroku run, ssh, sh -c), so the
#                      expression is quoted for that shell and then for the local one;
#   unquoted           only the local shell parses it, so it is quoted once.
# Either way, write the expression with normal single quotes.

set -euo pipefail

die() {
  echo "rq: $*" >&2
  exit 2
}

# Prints `name<TAB>command` for every remote in ./.rails_query_remote.
# Each line is `name: command`; the command is everything after the first `: `, taken literally.
remotes() {
  local file="$PWD/.rails_query_remote" line n=0 name value seen=" " out=""
  [[ -f "$file" ]] || die "no .rails_query_remote in $PWD"

  while IFS= read -r line || [[ -n "$line" ]]; do
    ((n += 1))
    line="${line%$'\r'}"
    [[ "$line" =~ ^[[:space:]]*(#.*)?$ ]] && continue
    [[ "$line" =~ ^([A-Za-z0-9_.-]+):([[:space:]]+(.*))?$ ]] ||
      die "$file:$n: expected 'name: command'"
    name="${BASH_REMATCH[1]}"
    value="${BASH_REMATCH[3]}"
    value="${value%"${value##*[![:space:]]}"}"
    [[ -n "$value" ]] || die "$file:$n: remote $name has no command"
    [[ "$seen" != *" $name "* ]] || die "$file:$n: remote $name is defined twice"
    seen+="$name "
    [[ "$value" != *$'\t'* ]] || die "$file:$n: remote $name has a tab in its command"
    [[ "$value" == *"{args}"* ]] || die "$file:$n: remote $name has no {args} in its command"
    out+="$name"$'\t'"$value"$'\n'
  done <"$file"
  printf '%s' "$out"
}

safe() {
  [[ "$1" =~ ^[A-Za-z0-9_.-]+$ ]] || die "invalid value '$1' (allowed: letters, digits, _ . -)"
  printf '%s' "$1"
}

original=("$@")
remote=""
flags=()
positional=()

while (($#)); do
  case "$1" in
  --remotes)
    remotes
    exit
    ;;
  -r | --remote)
    (($# >= 2)) || die "$1 needs a value"
    remote="$(safe "$2")"
    shift 2
    ;;
  --remote=*)
    remote="$(safe "${1#*=}")"
    shift
    ;;
  --sql)
    flags+=(--sql)
    shift
    ;;
  --db | --database | --page | --per | -e | --environment)
    (($# >= 2)) || die "$1 needs a value"
    flags+=("$1" "$(safe "$2")")
    shift 2
    ;;
  --db=* | --database=* | --page=* | --per=* | --environment=*)
    flags+=("${1%%=*}" "$(safe "${1#*=}")")
    shift
    ;;
  --)
    shift
    positional+=("$@")
    break
    ;;
  -)
    positional+=("-")
    shift
    ;;
  -*)
    die "unknown option $1"
    ;;
  *)
    positional+=("$1")
    shift
    ;;
  esac
done

read_expression() {
  if [[ -z "${1:-}" || "$1" == "-" ]]; then
    [[ -t 0 ]] && die "no expression given"
    cat
  else
    printf '%s' "$1"
  fi
}

[[ -n "$remote" ]] || exec bin/rails query "${original[@]}"

table="$(remotes)"
template="$(awk -F '\t' -v name="$remote" '$1 == name { sub(/^[^\t]*\t/, ""); print; exit }' <<<"$table")"
[[ -n "$template" ]] || die "unknown remote '$remote' (configured: $(cut -f1 <<<"$table" | paste -sd ' '))"

# Quote state (none/single/double) of the shell at the first {args} in the template.
prefix="${template%%"{args}"*}"
context=none
for ((i = 0; i < ${#prefix}; i++)); do
  c="${prefix:i:1}"
  case "$context" in
  none)
    case "$c" in
    \\) ((i += 1)) ;;
    \') context=single ;;
    \") context=double ;;
    esac
    ;;
  single)
    [[ "$c" == \' ]] && context=none
    ;;
  double)
    case "$c" in
    \\) ((i += 1)) ;;
    \") context=none ;;
    esac
    ;;
  esac
done

quote() {
  local remote
  case "$context" in
  none)
    printf '%q' "$1"
    ;;
  single)
    remote="'${1//\'/\'\\\'\'}'"
    printf '%s' "${remote//\'/\'\\\'\'}"
    ;;
  double)
    remote="'${1//\'/\'\\\'\'}'"
    remote="${remote//\\/\\\\}"
    remote="${remote//\$/\\\$}"
    remote="${remote//\`/\\\`}"
    printf '%s' "${remote//\"/\\\"}"
    ;;
  esac
}

expression=""
case "${positional[0]:-}" in
schema)
  ((${#positional[@]} <= 2)) || die "schema takes at most one table name"
  args=(schema)
  [[ -n "${positional[1]:-}" ]] && args+=("$(safe "${positional[1]}")")
  ;;
models)
  ((${#positional[@]} == 1)) || die "models takes no arguments"
  args=(models)
  ;;
explain)
  ((${#positional[@]} <= 2)) || die "quote the expression as a single argument"
  expression="$(read_expression "${positional[1]:-}")"
  args=(explain "$(quote "$expression")")
  ;;
*)
  ((${#positional[@]} <= 1)) || die "quote the expression as a single argument"
  expression="$(read_expression "${positional[0]:-}")"
  args=("$(quote "$expression")")
  ;;
esac
args+=("${flags[@]}")

# Splice rather than ${template//"{args}"/…}: bash 5.2 treats `\` and `&` in the replacement specially.
command="${prefix}${args[*]}${template#*"{args}"}"

# The remote never needs stdin (the expression is already in the command), so it gets none.
# Everything it prints — runner banners, boot logs, the result — is collected and printed once it
# exits: to stdout when it succeeds, to stderr when it fails. Exit with the remote's status.
output="$(mktemp)"
trap 'rm -f "$output"' EXIT

status=0
bash -c "$command" </dev/null >"$output" 2>&1 || status=$?

if ((status == 0)); then
  cat "$output"
else
  cat "$output" >&2
fi
exit "$status"
