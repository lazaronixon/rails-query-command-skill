#!/usr/bin/env bash
# rq — run `rails query` locally or on a remote defined in .rails_query_remote.yml.
#
# Usage: rq [--remote NAME] [--debug] [--sql] [--db NAME] [--page N] [--per N] [-e ENV] (EXPRESSION | - | schema [TABLE] | models | explain EXPRESSION)
#        rq --remotes    List the configured remotes.
#
# --debug prints the expression and final command to stderr.
#
# Without --remote, runs `bin/rails query` locally.
#
# Remotes come from .rails_query_remote.yml in the current directory or the nearest parent,
# a flat YAML mapping of name to command:
#
#   platform_beta: heroku run --no-tty --exit-code --app platform-api-beta "cd apps/api && bin/rails query {args}"
#
# The command is taken literally. `{args}` is replaced with the query arguments; without `{args}`
# they are appended. `$1` is still accepted in place of `{args}` for older templates.
#
# Quoting follows where `{args}` sits in the command:
#   inside "…" or '…'  the string is handed to a remote shell (heroku run, ssh, sh -c), so the
#                      expression is quoted for that shell and then for the local one;
#   unquoted           only the local shell parses it, so it is quoted once.
# Either way, write the expression with normal single quotes.

set -euo pipefail

die() { echo "rq: $*" >&2; exit 2; }

# Prints `name<TAB>command` for every remote in the nearest .rails_query_remote.yml.
# Reads a flat YAML subset: `name: command` lines with plain, 'single' or "double" quoted values.
remotes() {
  local dir="$PWD" file line n=0 name value seen=" " out=""
  until [[ -f "$dir/.rails_query_remote.yml" ]]; do
    [[ "$dir" == / ]] && die "no .rails_query_remote.yml in $PWD or its parents"
    dir="$(dirname "$dir")"
  done
  file="$dir/.rails_query_remote.yml"

  while IFS= read -r line || [[ -n "$line" ]]; do
    ((n += 1))
    line="${line%$'\r'}"
    [[ "$line" =~ ^[[:space:]]*(#.*)?$ ]] && continue
    [[ "$line" =~ ^([A-Za-z0-9_.-]+):([[:space:]]+(.*))?$ ]] ||
      die "$file:$n: expected 'name: command' (nesting, lists and quoted names aren't supported)"
    name="${BASH_REMATCH[1]}"
    value="${BASH_REMATCH[3]}"
    value="${value%"${value##*[![:space:]]}"}"
    [[ -n "$value" ]] || die "$file:$n: remote $name has no command"
    [[ "$seen" != *" $name "* ]] || die "$file:$n: remote $name is defined twice"
    seen+="$name "
    value="$(unquote "$value")" || die "$file:$n: $value"
    [[ -n "$value" ]] || die "$file:$n: remote $name has no command"
    [[ "$value" != *$'\t'* ]] || die "$file:$n: remote $name has a tab in its command"
    out+="$name"$'\t'"$value"$'\n'
  done <"$file"
  printf '%s' "$out"
}

# Decodes one YAML scalar. On failure prints the reason and returns 1.
unquote() {
  local v="$1" inner out="" i c
  case "$v" in
    \'*)
      [[ "$v" == ?*\' ]] && inner="${v:1:${#v}-2}" && [[ "${inner//\'\'/}" != *\'* ]] ||
        { echo "invalid single-quoted value (double any ' inside it; comments after a value aren't supported)"; return 1; }
      printf '%s' "${inner//\'\'/\'}" ;;
    \"*)
      [[ "$v" =~ ^\"(([^\"\\]|\\.)*)\"$ ]] ||
        { echo "invalid double-quoted value (escape any \" inside it; comments after a value aren't supported)"; return 1; }
      inner="${BASH_REMATCH[1]}"
      for ((i = 0; i < ${#inner}; i++)); do
        c="${inner:i:1}"
        if [[ "$c" == \\ ]]; then
          ((i += 1)); c="${inner:i:1}"
          [[ "$c" == [\"\\/] ]] || { echo "only \\\" \\\\ and \\/ escapes are supported in double quotes"; return 1; }
        fi
        out+="$c"
      done
      printf '%s' "$out" ;;
    [\[\{\&\*\!\|\>\%\@\`]*|"- "*|"? "*)
      echo "a value starting with ${v:0:1} must be quoted"; return 1 ;;
    *" #"*)
      echo "comments after a value aren't supported (quote the value if # is part of the command)"; return 1 ;;
    *": "*)
      echo "a value containing ': ' must be quoted"; return 1 ;;
    *)
      printf '%s' "$v" ;;
  esac
}

safe() {
  [[ "$1" =~ ^[A-Za-z0-9_.-]+$ ]] || die "invalid value '$1' (allowed: letters, digits, _ . -)"
  printf '%s' "$1"
}

original=("$@")
remote=""
debug=""
flags=()
positional=()

while (($#)); do
  case "$1" in
    --remotes)
      remotes; exit ;;
    -r|--remote)
      (($# >= 2)) || die "$1 needs a value"
      remote="$(safe "$2")"; shift 2 ;;
    --remote=*)
      remote="$(safe "${1#*=}")"; shift ;;
    --debug)
      debug=1; shift ;;
    --sql)
      flags+=(--sql); shift ;;
    --db|--database|--page|--per|-e|--environment)
      (($# >= 2)) || die "$1 needs a value"
      flags+=("$1" "$(safe "$2")"); shift 2 ;;
    --db=*|--database=*|--page=*|--per=*|--environment=*)
      flags+=("${1%%=*}" "$(safe "${1#*=}")"); shift ;;
    --)
      shift; positional+=("$@"); break ;;
    -)
      positional+=("-"); shift ;;
    -*)
      die "unknown option $1" ;;
    *)
      positional+=("$1"); shift ;;
  esac
done

read_expression() {
  if [[ -z "${1:-}" || "$1" == "-" ]]; then
    [[ -t 0 ]] && die "no expression given"
    cat
  else
    printf '%s' "$1"
  fi
}

[[ -n "$remote" ]] || exec bin/rails query "${original[@]}"

table="$(remotes)"
template="$(awk -F '\t' -v name="$remote" '$1 == name { sub(/^[^\t]*\t/, ""); print; exit }' <<<"$table")"
[[ -n "$template" ]] || die "unknown remote '$remote' (configured: $(cut -f1 <<<"$table" | paste -sd ' '))"

placeholder='{args}'
if [[ "$template" != *"$placeholder"* ]]; then
  # Older templates used `$1`.
  if [[ "$template" == *'$1'* ]]; then
    placeholder='$1'
  else
    template="$template $placeholder"
  fi
fi

# Quote state (none/single/double) of the shell at the first placeholder in the template.
prefix="${template%%"$placeholder"*}"
context=none
for ((i = 0; i < ${#prefix}; i++)); do
  c="${prefix:i:1}"
  case "$context" in
    none)
      case "$c" in
        \\) ((i += 1)) ;;
        \') context=single ;;
        \") context=double ;;
      esac ;;
    single)
      [[ "$c" == \' ]] && context=none ;;
    double)
      case "$c" in
        \\) ((i += 1)) ;;
        \") context=none ;;
      esac ;;
  esac
done

quote() {
  local remote
  case "$context" in
    none)
      printf '%q' "$1" ;;
    single)
      remote="'${1//\'/\'\\\'\'}'"
      printf '%s' "${remote//\'/\'\\\'\'}" ;;
    double)
      remote="'${1//\'/\'\\\'\'}'"
      remote="${remote//\\/\\\\}"
      remote="${remote//\$/\\\$}"
      remote="${remote//\`/\\\`}"
      printf '%s' "${remote//\"/\\\"}" ;;
  esac
}

expression=""
case "${positional[0]:-}" in
  schema)
    ((${#positional[@]} <= 2)) || die "schema takes at most one table name"
    args=(schema)
    [[ -n "${positional[1]:-}" ]] && args+=("$(safe "${positional[1]}")")
    ;;
  models)
    ((${#positional[@]} == 1)) || die "models takes no arguments"
    args=(models) ;;
  explain)
    ((${#positional[@]} <= 2)) || die "quote the expression as a single argument"
    expression="$(read_expression "${positional[1]:-}")"
    args=(explain "$(quote "$expression")") ;;
  *)
    ((${#positional[@]} <= 1)) || die "quote the expression as a single argument"
    expression="$(read_expression "${positional[0]:-}")"
    args=("$(quote "$expression")") ;;
esac
args+=("${flags[@]}")

# Splice rather than ${template//"$placeholder"/…}: bash 5.2 treats `\` and `&` in the replacement specially.
command="${prefix}${args[*]}${template#*"$placeholder"}"

if [[ -n "$debug" ]]; then
  [[ -n "$expression" ]] && echo "rq: expression: $expression" >&2
  echo "rq: command: $command" >&2
fi

# Remote runners (heroku run, ssh, …) mix banners and boot logs into stdout. Keep the last JSON
# line as the result and send everything else to stderr.
output="$(mktemp)"
trap 'rm -f "$output"' EXIT

status=0
bash -c "$command" </dev/null >"$output" || status=$?

tr -d '\r' <"$output" >"$output.clean" && mv "$output.clean" "$output"
json="$(grep -E '^[[:space:]]*[[{]' "$output" | tail -n 1 || true)"

if [[ -z "$json" ]]; then
  cat "$output" >&2
  # A failing `rails query` already wrote its JSON error to stderr.
  ((status != 0)) && exit "$status"
  echo "rq: no JSON in output" >&2
  exit 1
fi

grep -vxF -- "$json" "$output" >&2 || true

if ((status == 0)) && [[ "$json" != '{"error":'* ]]; then
  printf '%s\n' "$json"
else
  printf '%s\n' "$json" >&2
  exit $((status == 0 ? 1 : status))
fi
